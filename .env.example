TSETMC_USERNAME=your_username
TSETMC_PASSWORD=your_password
TSETMC_BASE_URL=https://api.tsetmc.com
TSETMC_FLOW=3
TSETMC_LOGIN_TIMEOUT=10
TSETMC_REQUEST_TIMEOUT=60
TSETMC_TRUST_ENV_PROXY=0
TSETMC_PUBLIC_CLIENT_TYPE_WORKERS=16

# Optional runtime overrides. By default BeeWare uses the app data directory.
# DATABASE_PATH=/path/to/tsetmc_options.db
# DATA_DIR=/path/to/exports
